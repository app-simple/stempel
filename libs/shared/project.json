{
  "name": "shared",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/src",
  "projectType": "library",
  "tags": ["type:shared"],
  "// targets": "to see all targets run: nx show project shared --web",
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/shared/tsconfig.lib.json",
          "tsc --noEmit -p libs/shared/tsconfig.spec.json"
        ],
        "parallel": false
      }
    }
  }
}

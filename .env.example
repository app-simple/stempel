# Nur Entwicklungswerte. Für Produktion werden alle Werte über die Umgebung gesetzt,
# Secrets nie ins Repo. `pnpm dev` kopiert diese Datei nach .env, falls .env fehlt.

NODE_ENV=development

# Docker Compose
POSTGRES_USER=asos
POSTGRES_PASSWORD=asos-dev
POSTGRES_DB=asos
POSTGRES_PORT=5442
MAILPIT_SMTP_PORT=1036
MAILPIT_UI_PORT=8036

# API
API_PORT=3000
DATABASE_URL=postgresql://asos:asos-dev@localhost:5442/asos
TEST_DATABASE_URL=postgresql://asos:asos-dev@localhost:5442/asos_test

# Öffentliche Adresse der Weboberfläche (Origin-Prüfung, WebAuthn, Links in E-Mails)
APP_ORIGIN=http://localhost:4200
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Zeit & Urlaub
# Optional, Standard ist APP_ORIGIN
# WEBAUTHN_ORIGIN=http://localhost:4200

# Mindestdauer fehlgeschlagener Code-Prüfungen in ms (gleicht Antwortzeiten an)
AUTH_FAILURE_FLOOR_MS=400

# Geheimnis für HMAC von Anmeldecodes und Rate-Limit-Schlüsseln.
# Produktion: mindestens 32 zufällige Bytes, z. B. `openssl rand -base64 48`.
AUTH_PEPPER=dev-only-pepper-change-me-0123456789abcdef

# Anzahl vertrauenswürdiger Proxys vor der API (Ingress im Cluster), für die Client-IP im Rate-Limit.
TRUST_PROXY_HOPS=0

# Secure-Cookie. Nur in der Entwicklung abschaltbar (Safari unter http://localhost).
COOKIE_SECURE=true

# E-Mail-Versand (lokal Mailpit)
SMTP_HOST=localhost
SMTP_PORT=1036
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Zeit & Urlaub <zeit@example.com>"

# Web Push für Erinnerungen (Phase 5). Leer lassen = nur Banner und E-Mail.
# Schlüsselpaar erzeugen: pnpm exec web-push generate-vapid-keys
# Den privaten Schlüssel nie ins Repo; in der Produktion als Secret setzen.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt für die Push-Dienste (mailto: oder https-URL); Standard ist APP_ORIGIN.
VAPID_SUBJECT=

  "scripts": {
    "dev": "node tools/scripts/dev.mjs",
    "services:up": "docker compose --env-file .env up -d --wait",
    "services:down": "docker compose down",
    "lint": "nx run-many -t lint",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "prettier --check . && nx run-many -t lint typecheck test test-int",
    "test-int": "nx run-many -t test-int",
    "e2e": "nx run e2e:e2e",
    "oss:export": "node tools/scripts/export-oss.mjs"
  },

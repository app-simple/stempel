{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/src",
  "projectType": "application",
  "tags": ["scope:api", "type:app"],
  "targets": {
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/pnpm-workspace.yaml",
        "{workspaceRoot}/package.json",
        {
          "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
        }
      ],
      "outputs": [
        "{workspaceRoot}/dist/apps/api/package.json",
        "{workspaceRoot}/dist/apps/api/pnpm-lock.yaml",
        "{workspaceRoot}/dist/apps/api/pnpm-workspace.yaml",
        "{workspaceRoot}/dist/apps/api/patches",
        "{workspaceRoot}/dist/apps/api/local_path_modules"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "api:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      },
      "dependsOn": ["prisma-generate"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p apps/api/tsconfig.app.json",
          "tsc --noEmit -p apps/api/tsconfig.spec.json"
        ],
        "parallel": false
      },
      "dependsOn": ["prisma-generate"]
    },
    "prisma-generate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["{projectRoot}/prisma/schema.prisma", "{projectRoot}/prisma.config.ts"],
      "outputs": ["{projectRoot}/src/generated/prisma"],
      "options": {
        "command": "prisma generate --config apps/api/prisma.config.ts"
      }
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate deploy --config apps/api/prisma.config.ts"
      }
    },
    "migrate-dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate dev --config apps/api/prisma.config.ts"
      }
    },
    "seed": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma db seed --config apps/api/prisma.config.ts"
      },
      "dependsOn": ["prisma-generate"]
    },
    "db-reset": {
      "executor": "nx:run-commands",
      "options": {
        "command": "prisma migrate reset --force --config apps/api/prisma.config.ts"
      }
    },
    "build": {
      "dependsOn": ["^build", "prisma-generate"]
    },
    "lint": {
      "dependsOn": ["prisma-generate"]
    },
    "test-int": {
      "executor": "@nx/jest:jest",
      "dependsOn": ["prisma-generate"],
      "options": {
        "jestConfig": "apps/api/jest.int.config.cts",
        "runInBand": true
      }
    },
    "create-admin": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": {
        "command": "tsx --tsconfig apps/api/tsconfig.json apps/api/prisma/create-admin.ts"
      }
    },
    "seed-stammdaten": {
      "executor": "nx:run-commands",
      "dependsOn": ["prisma-generate"],
      "options": {
        "command": "tsx --tsconfig apps/api/tsconfig.json apps/api/prisma/seed.ts --nur-stammdaten"
      }
    }
  }
}
